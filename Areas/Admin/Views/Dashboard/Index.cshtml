@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container-fluid py-4">

    <!-- Dashboard Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">
                <i class="bi bi-speedometer2"></i>
                Admin Dashboard
            </h1>

            <p class="text-muted mb-0">
                Laboratory Inventory Management Overview
            </p>
        </div>

        <span class="badge bg-success px-3 py-2">
            <i class="bi bi-check-circle"></i>
            System Active
        </span>
    </div>


    <!-- Summary Cards -->
    <div class="row g-4 mb-4">

        <!-- Total Supplies -->
        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <p class="text-muted mb-1">
                                Total Supplies
                            </p>

                            <h2 class="fw-bold mb-1">
                                @ViewBag.TotalSupplies
                            </h2>

                            <small class="text-muted">
                                Laboratory items
                            </small>
                        </div>

                        <div class="fs-1">
                            📦
                        </div>

                    </div>

                </div>
            </div>
        </div>


        <!-- Low Stock -->
        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <p class="text-muted mb-1">
                                Low Stock
                            </p>

                            <h2 class="fw-bold text-warning mb-1">
                                @ViewBag.LowStockItems
                            </h2>

                            <small class="text-danger">
                                Requires attention
                            </small>
                        </div>

                        <div class="fs-1">
                            ⚠️
                        </div>

                    </div>

                </div>
            </div>
        </div>


        <!-- Suppliers -->
        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <p class="text-muted mb-1">
                                Total Suppliers
                            </p>

                            <h2 class="fw-bold mb-1">
                                @ViewBag.TotalSuppliers
                            </h2>

                            <small class="text-muted">
                                Registered suppliers
                            </small>
                        </div>

                        <div class="fs-1">
                            🏢
                        </div>

                    </div>

                </div>
            </div>
        </div>


        <!-- Pending Orders -->
        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <p class="text-muted mb-1">
                                Pending Orders
                            </p>

                            <h2 class="fw-bold text-primary mb-1">
                                @ViewBag.PendingOrders
                            </h2>

                            <small class="text-warning">
                                Awaiting processing
                            </small>
                        </div>

                        <div class="fs-1">
                            🛒
                        </div>

                    </div>

                </div>
            </div>
        </div>

    </div>


    <!-- Inventory + Quick Actions -->
    <div class="row g-4">

        <!-- Inventory Overview -->
        <div class="col-lg-8">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-box-seam"></i>
                        Inventory Overview
                    </h5>
                </div>

                <div class="card-body">

                    <div class="table-responsive">

                        <table class="table table-hover align-middle">

                            <thead>
                                <tr>
                                    <th>Supply</th>
                                    <th>Supplier</th>
                                    <th>Quantity</th>
                                    <th>Reorder Point</th>
                                    <th>Status</th>
                                </tr>
                            </thead>

                            <tbody>

                                @if (ViewBag.LowStockSupplies != null &&
                                     ViewBag.LowStockSupplies.Count > 0)
                                {
                                    foreach (var supply in ViewBag.LowStockSupplies)
                                    {
                                        <tr>

                                            <td>
                                                <strong>
                                                    @supply.SupplyName
                                                </strong>
                                            </td>

                                            <td>
                                                @(supply.Supplier?.SupplierName ?? "N/A")
                                            </td>

                                            <td>
                                                @supply.QuantityOnHand
                                            </td>

                                            <td>
                                                @supply.ReorderPoint
                                            </td>

                                            <td>
                                                @if (supply.QuantityOnHand == 0)
                                                {
                                                    <span class="badge bg-danger">
                                                        Out of Stock
                                                    </span>
                                                }
                                                else if (supply.QuantityOnHand <= supply.ReorderPoint)
                                                {
                                                    <span class="badge bg-warning text-dark">
                                                        Low Stock
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success">
                                                        Available
                                                    </span>
                                                }
                                            </td>

                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center text-muted py-4">
                                            No low-stock supplies found.
                                        </td>
                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </div>


        <!-- Quick Actions -->
        <div class="col-lg-4">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-lightning-charge"></i>
                        Quick Actions
                    </h5>
                </div>

                <div class="card-body">

                    <a href="/Admin/LabSupplies"
                       class="btn btn-primary w-100 mb-3">
                        <i class="bi bi-box-seam"></i>
                        Manage Supplies
                    </a>


                    <a href="/Admin/Suppliers"
                       class="btn btn-outline-primary w-100 mb-3">
                        <i class="bi bi-building"></i>
                        Manage Suppliers
                    </a>


                    <a href="/User/PurchaseOrders"
                       class="btn btn-outline-primary w-100 mb-3">
                        <i class="bi bi-cart"></i>
                        Purchase Orders
                    </a>


                    <a href="/Admin/StockAdjustment"
                       class="btn btn-outline-secondary w-100">
                        <i class="bi bi-arrow-left-right"></i>
                        Stock Adjustment
                    </a>

                </div>

            </div>


            <!-- Inventory Alert -->
            <div class="card border-0 shadow-sm mt-4">

                <div class="card-body">

                    <h6 class="fw-bold text-warning">
                        <i class="bi bi-exclamation-triangle"></i>
                        Inventory Alert
                    </h6>

                    <p class="text-muted mb-0">

                        There are currently

                        <strong>
                            @ViewBag.LowStockItems
                        </strong>

                        laboratory supplies at or below their
                        reorder level.

                    </p>

                </div>

            </div>

        </div>

    </div>


    <!-- Additional Dashboard Information -->
    <div class="row mt-4">

        <!-- Out of Stock -->
        <div class="col-md-4 mb-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body text-center">

                    <div class="fs-1 mb-2">
                        🚨
                    </div>

                    <h6 class="text-muted">
                        Out of Stock
                    </h6>

                    <h3 class="fw-bold text-danger">
                        @ViewBag.OutOfStockItems
                    </h3>

                    <p class="text-muted mb-0">
                        Supplies with zero quantity
                    </p>

                </div>

            </div>

        </div>


        <!-- Completed Orders -->
        <div class="col-md-4 mb-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body text-center">

                    <div class="fs-1 mb-2">
                        ✅
                    </div>

                    <h6 class="text-muted">
                        Completed Orders
                    </h6>

                    <h3 class="fw-bold text-success">
                        @ViewBag.CompletedOrders
                    </h3>

                    <p class="text-muted mb-0">
                        Successfully completed purchase orders
                    </p>

                </div>

            </div>

        </div>


        <!-- Suppliers -->
        <div class="col-md-4 mb-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body text-center">

                    <div class="fs-1 mb-2">
                        🏢
                    </div>

                    <h6 class="text-muted">
                        Suppliers
                    </h6>

                    <h3 class="fw-bold">
                        @ViewBag.TotalSuppliers
                    </h3>

                    <p class="text-muted mb-0">
                        Registered laboratory suppliers
                    </p>

                </div>

            </div>

        </div>

    </div>


    <!-- Dashboard Footer Information -->
    <div class="row mt-2">

        <div class="col-12">

            <div class="card border-0 shadow-sm">

                <div class="card-body">

                    <div class="row text-center">

                        <div class="col-md-4">
                            <h6 class="text-muted">
                                Inventory Monitoring
                            </h6>

                            <p class="mb-0">
                                Monitor laboratory supplies and stock levels.
                            </p>
                        </div>


                        <div class="col-md-4">
                            <h6 class="text-muted">
                                Supplier Management
                            </h6>

                            <p class="mb-0">
                                Keep track of registered laboratory suppliers.
                            </p>
                        </div>


                        <div class="col-md-4">
                            <h6 class="text-muted">
                                Purchase Management
                            </h6>

                            <p class="mb-0">
                                Monitor pending and completed purchase orders.
                            </p>
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>