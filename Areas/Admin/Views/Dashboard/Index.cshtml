@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid py-4">

    <!-- Dashboard Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">Dashboard</h1>
            <p class="text-muted mb-0">
                Laboratory Inventory Management Overview
            </p>
        </div>

        <span class="badge bg-success px-3 py-2">
            System Active
        </span>
    </div>


    <!-- Summary Cards -->
    <div class="row g-4 mb-4">

        <!-- Total Supplies -->
        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-2">
                                Total Supplies
                            </h6>

                            <h2 class="fw-bold mb-1">
                                @ViewBag.TotalSupplies
                            </h2>

                            <small class="text-muted">
                                Laboratory items
                            </small>
                        </div>

                        <div class="fs-1">
                            📦
                        </div>
                    </div>
                </div>
            </div>
        </div>


        <!-- Low Stock -->
        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-2">
                                Low Stock
                            </h6>

                            <h2 class="fw-bold mb-1">
                                @ViewBag.LowStock
                            </h2>

                            <small class="text-danger">
                                Requires attention
                            </small>
                        </div>

                        <div class="fs-1">
                            ⚠️
                        </div>
                    </div>
                </div>
            </div>
        </div>


        <!-- Suppliers -->
        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-2">
                                Total Suppliers
                            </h6>

                            <h2 class="fw-bold mb-1">
                                @ViewBag.TotalSuppliers
                            </h2>

                            <small class="text-muted">
                                Registered suppliers
                            </small>
                        </div>

                        <div class="fs-1">
                            🏢
                        </div>
                    </div>
                </div>
            </div>
        </div>


        <!-- Pending Orders -->
        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-2">
                                Pending Orders
                            </h6>

                            <h2 class="fw-bold mb-1">
                                @ViewBag.PendingOrders
                            </h2>

                            <small class="text-warning">
                                Awaiting processing
                            </small>
                        </div>

                        <div class="fs-1">
                            🛒
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>


    <!-- Main Dashboard Content -->
    <div class="row g-4">

        <!-- Inventory Overview -->
        <div class="col-lg-8">

            <div class="card shadow-sm border-0">

                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fw-bold">
                        Inventory Overview
                    </h5>
                </div>

                <div class="card-body">

                    <div class="table-responsive">

                        <table class="table table-hover align-middle">

                            <thead>
                                <tr>
                                    <th>Supply</th>
                                    <th>Category</th>
                                    <th>Quantity</th>
                                    <th>Status</th>
                                </tr>
                            </thead>

                            <tbody>

                                <tr>
                                    <td>Laboratory Gloves</td>
                                    <td>Safety Equipment</td>
                                    <td>250</td>
                                    <td>
                                        <span class="badge bg-success">
                                            Available
                                        </span>
                                    </td>
                                </tr>

                                <tr>
                                    <td>Test Tubes</td>
                                    <td>Laboratory Equipment</td>
                                    <td>80</td>
                                    <td>
                                        <span class="badge bg-success">
                                            Available
                                        </span>
                                    </td>
                                </tr>

                                <tr>
                                    <td>Reagent Kits</td>
                                    <td>Reagents</td>
                                    <td>8</td>
                                    <td>
                                        <span class="badge bg-danger">
                                            Low Stock
                                        </span>
                                    </td>
                                </tr>

                                <tr>
                                    <td>Syringes</td>
                                    <td>Medical Supplies</td>
                                    <td>45</td>
                                    <td>
                                        <span class="badge bg-warning text-dark">
                                            Attention
                                        </span>
                                    </td>
                                </tr>

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </div>


        <!-- Quick Actions -->
        <div class="col-lg-4">

            <div class="card shadow-sm border-0">

                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fw-bold">
                        Quick Actions
                    </h5>
                </div>

                <div class="card-body">

                    <a href="#" class="btn btn-primary w-100 mb-3">
                        Manage Supplies
                    </a>

                    <a href="#" class="btn btn-outline-primary w-100 mb-3">
                        Manage Suppliers
                    </a>

                    <a href="#" class="btn btn-outline-primary w-100 mb-3">
                        Purchase Orders
                    </a>

                    <a href="#" class="btn btn-outline-secondary w-100">
                        Stock Adjustment
                    </a>

                </div>

            </div>


            <!-- Alert Card -->
            <div class="card shadow-sm border-0 mt-4">

                <div class="card-body">

                    <h6 class="fw-bold">
                        ⚠️ Inventory Alert
                    </h6>

                    <p class="text-muted mb-0">
                        There are currently
                        <strong>@ViewBag.LowStock</strong>
                        laboratory supplies below their reorder level.
                    </p>

                </div>

            </div>

        </div>

    </div>

</div>